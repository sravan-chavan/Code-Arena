# CodeArena local development environment template
# Copy to .env: cp .env.example .env
# Never commit real credentials.

NODE_ENV=development
NODE_VERSION=24

# PostgreSQL (container + API client)
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena_dev_password
POSTGRES_PORT=5432

# API PostgreSQL client (Compose overrides DB_HOST=postgres inside the api container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codearena
DB_USER=codearena
DB_PASSWORD=codearena_dev_password
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=2000

# JWT (required by the API for authentication)
# Replace with a long random secret before any non-local deployment.
# Do not use this example value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# RabbitMQ
RABBITMQ_USER=codearena
RABBITMQ_PASSWORD=codearena_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application ports (host bindings)
API_PORT=4000
ADMIN_PORT=3001
CLIENT_PORT=3002
WORKER_PORT=4001
NGINX_PORT=8080

# Internal service ports (container)
API_INTERNAL_PORT=4000
ADMIN_INTERNAL_PORT=3000
CLIENT_INTERNAL_PORT=3000
WORKER_INTERNAL_PORT=4001
