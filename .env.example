# CodeArena local development environment template
# Copy to .env: cp .env.example .env
# Never commit real credentials.

NODE_ENV=development
NODE_VERSION=24

# Service identity used by shared messaging logs and AMQP appId
# (codearena-api / codearena-worker). Compose sets these per service.
# CODEARENA_SERVICE_NAME=api

# PostgreSQL (container + API client)
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena_dev_password
POSTGRES_PORT=5432

# API PostgreSQL client (Compose overrides DB_HOST=postgres inside the api container)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codearena
DB_USER=codearena
DB_PASSWORD=codearena_dev_password
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=2000

# JWT (required by the API for authentication)
# Replace with a long random secret before any non-local deployment.
# Do not use this example value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# RabbitMQ
# Compose injects RABBITMQ_HOST=rabbitmq into the api and worker containers.
# Host-side tools and integration tests use localhost / 127.0.0.1.
RABBITMQ_HOST=localhost
RABBITMQ_USER=codearena
RABBITMQ_PASSWORD=codearena_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
# Optional full AMQP URL. When set, it overrides host/port/user/password/vhost.
# Leave empty for Compose. A localhost URL would break api/worker containers.
# Required (host tools): RABBITMQ_HOST, RABBITMQ_PORT, RABBITMQ_USER, RABBITMQ_PASSWORD, RABBITMQ_VHOST
# Where: same values as the RabbitMQ container (RABBITMQ_USER / RABBITMQ_PASSWORD above).
# RABBITMQ_URL=
# Optional topology overrides. Defaults live in packages/messaging/src/config.js.
# RABBITMQ_EXCHANGE=codearena.events
# RABBITMQ_DLX=codearena.events.dlx
# RABBITMQ_SYSTEM_QUEUE=codearena.system
# RABBITMQ_SYSTEM_DLQ=codearena.system.dlq
# RABBITMQ_EXECUTION_QUEUE=codearena.execution
# RABBITMQ_EXECUTION_DLQ=codearena.execution.dlq
# RABBITMQ_EXECUTION_RESULT_QUEUE=codearena.execution.results
# RABBITMQ_EXECUTION_RESULT_DLQ=codearena.execution.results.dlq
# RABBITMQ_PREFETCH=1
# RABBITMQ_CONSUMER_ENABLED=true
# Worker runtime reconnect (API does not use reconnect).
# RABBITMQ_RECONNECT_ENABLED=true
# RABBITMQ_RECONNECT_INITIAL_DELAY_MS=500
# RABBITMQ_RECONNECT_MAX_DELAY_MS=15000
# RABBITMQ_RECONNECT_MAX_ATTEMPTS=0
# WORKER_SHUTDOWN_GRACE_MS=8000

# Judge0 CE (M7). Judge0 is intentionally external — it is not started by
# docker-compose.yml. Point this at a running Judge0 instance.
#
# JUDGE0_URL (required for Worker): base URL of Judge0 CE.
#   From Compose Worker: http://host.docker.internal:2358 (host-bound Judge0).
#   Confirm with: curl http://localhost:2358/about  (or your Judge0 host/port)
#
# JUDGE0_AUTH_TOKEN (optional): Judge0 X-Auth-Token header.
#   Required only if the Judge0 instance enables authentication.
#   Obtain from the Judge0 deployment environment (AUTH_TOKEN / JUDGE0_ACCESS_TOKEN).
#   Leave empty when authentication is disabled (typical local CE). Never commit a real token.
JUDGE0_URL=http://host.docker.internal:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLL_ATTEMPTS=30
JUDGE0_REQUEST_TIMEOUT_MS=10000

# WebSocket gateway (single API instance; no Redis)
# Browser connects to Nginx /ws, which upgrades to the API.
# WS_ENABLED=true
# WS_PATH=/ws
# WS_MAX_CONNECTIONS=500
# WS_MAX_CONNECTIONS_PER_USER=4
# WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=8
# WS_AUTH_TIMEOUT_MS=5000
# WS_HEARTBEAT_INTERVAL_MS=25000
# WS_MAX_PAYLOAD_BYTES=65536
# WS_RANKING_SNAPSHOT_MAX=200
# WS_CONTEST_WATCH_ENABLED=true
# WS_CONTEST_WATCH_INTERVAL_MS=5000
# WS_CONTEST_ENDING_LEAD_SECONDS=60

# Application ports (host bindings)
API_PORT=4000
WORKER_PORT=4001
NGINX_PORT=8080

# Internal service ports (container)
API_INTERNAL_PORT=4000
WORKER_INTERNAL_PORT=4001
